<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Matrix 8x8 LED Simulator</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #111;
            color: #00ff41;
            font-family: 'Courier New', Courier, monospace;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
        }

        h1 {
            margin-bottom: 20px;
            font-size: 1.8rem;
            text-shadow: 0 0 10px #00ff41;
            text-align: center;
        }

        /* Contenedor de la Matriz 8x8 */
        .matrix-grid {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            grid-template-rows: repeat(8, 1fr);
            gap: 8px;
            background-color: #000;
            padding: 15px;
            border: 4px solid #333;
            border-radius: 10px;
            box-shadow: 0 0 30px rgba(0, 255, 65, 0.2);
            width: 340px;
            height: 340px;
        }

        /* Cada "LED" individual de la matriz */
        .led {
            background-color: #222;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            font-weight: bold;
            color: rgba(0, 255, 65, 0.1);
            transition: all 0.1s ease;
            user-select: none;
        }

        /* Estado encendido con brillo (efecto Matrix) */
        .led.active {
            background-color: #00ff41;
            color: #fff;
            box-shadow: 0 0 12px #00ff41, 0 0 20px #00ff41;
            text-shadow: 0 0 5px #fff;
        }

        /* Estado de desvanecimiento (rastro de la lluvia) */
        .led.fade {
            background-color: #003B00;
            color: #00ff41;
            box-shadow: 0 0 4px #003B00;
        }

        .controls {
            margin-top: 25px;
            display: flex;
            gap: 10px;
        }

        button {
            background-color: #000;
            color: #00ff41;
            border: 2px solid #00ff41;
            padding: 10px 20px;
            font-family: inherit;
            font-size: 1rem;
            cursor: pointer;
            border-radius: 5px;
            transition: all 0.3s ease;
        }

        button:hover {
            background-color: #00ff41;
            color: #000;
            box-shadow: 0 0 15px #00ff41;
        }
    </style>
</head>
<body>

    <h1>MATRIX 8x8 SIMULATOR</h1>

    <!-- Matriz de 64 LEDs -->
    <div class="matrix-grid" id="matrix"></div>

    <div class="controls">
        <button id="speedBtn">Velocidad: Normal</button>
        <button id="clearBtn">Reiniciar</button>
    </div>

    <script>
        const matrixContainer = document.getElementById('matrix');
        const speedBtn = document.getElementById('speedBtn');
        const clearBtn = document.getElementById('clearBtn');
        
        const ROWS = 8;
        const COLS = 8;
        const leds = [];
        
        // Caracteres aleatorios estilo Matrix (Katakana y números)
        const chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZｦｧｨｩｪｫｬｭｮｯｰｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ".split("");

        // Configuración de las columnas cayendo
        // Cada columna tiene una posición actual (y) y una velocidad/espera
        let drops = Array(COLS).fill(-1); 
        let speed = 150; // milisegundos
        let intervalId = null;

        // 1. Crear la estructura de la matriz 8x8
        function createMatrix() {
            matrixContainer.innerHTML = '';
            leds.length = 0;
            
            for (let i = 0; i < ROWS * COLS; i++) {
                const led = document.createElement('div');
                led.classList.add('led');
                led.textContent = chars[Math.floor(Math.random() * chars.length)];
                matrixContainer.appendChild(led);
                leds.push(led);
            }
        }

        // Obtener el elemento LED por coordenadas X (columna) e Y (fila)
        function getLed(x, y) {
            if (x >= 0 && x < COLS && y >= 0 && y < ROWS) {
                return leds[y * COLS + x];
            }
            return null;
        }

        // 2. Lógica de actualización de la lluvia Matrix
        function updateMatrix() {
            // Primero, desvanecemos ligeramente todos los LEDs activos anteriores
            for (let y = 0; y < ROWS; y++) {
                for (let x = 0; x < COLS; x++) {
                    const led = getLed(x, y);
                    if (led.classList.contains('active')) {
                        led.classList.remove('active');
                        led.classList.add('fade');
                    } else if (led.classList.contains('fade') && Math.random() > 0.4) {
                        // Simular que el rastro se apaga aleatoriamente
                        led.classList.remove('fade');
                    }
                    // Cambiar el carácter aleatoriamente para simular código vivo
                    if (Math.random() > 0.85) {
                        led.textContent = chars[Math.floor(Math.random() * chars.length)];
                    }
                }
            }

            // Mover las gotas de lluvia hacia abajo
            for (let x = 0; x < COLS; x++) {
                // Si la gota no ha empezado, hay una probabilidad de que aparezca arriba
                if (drops[x] === -1 && Math.random() > 0.7) {
                    drops[x] = 0;
                }

                if (drops[x] >= 0 && drops[x] < ROWS) {
                    const currentLed = getLed(x, drops[x]);
                    if (currentLed) {
                        currentLed.classList.remove('fade');
                        currentLed.classList.add('active');
                        currentLed.textContent = chars[Math.floor(Math.random() * chars.length)];
                    }
                    drops[x]++;
                } else if (drops[x] >= ROWS) {
                    // Si llegó al final, sacarla de la pantalla con opción de reiniciar
                    drops[x] = Math.random() > 0.9 ? -1 : ROWS; 
                    if(drops[x] === -1) {
                        // Limpieza del rastro al salir por completo
                        for(let y=0; y<ROWS; y++) getLed(x, y).classList.remove('fade');
                    }
                }
            }
        }

        // 3. Control del bucle de animación
        function startAnimation() {
            clearInterval(intervalId);
            intervalId = setInterval(updateMatrix, speed);
        }

        // Botón de Cambio de Velocidad
        speedBtn.addEventListener('click', () => {
            if (speed === 150) {
                speed = 70;
                speedBtn.textContent = "Velocidad: Rápido";
            } else if (speed === 70) {
                speed = 300;
                speedBtn.textContent = "Velocidad: Lento";
            } else {
                speed = 150;
                speedBtn.textContent = "Velocidad: Normal";
            }
            startAnimation();
        });

        // Botón de Reinicio
        clearBtn.addEventListener('click', () => {
            drops.fill(-1);
            createMatrix();
            startAnimation();
        });

        // Inicialización
        createMatrix();
        startAnimation();
    </script>
</body>
</html>
